---
import { ClientRouter } from 'astro:transitions';

import Header from '@components/header/Header.astro';
// @ts-expect-error": side-effect font import without type declarations
import 'cal-sans';
import '../styles/reset.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Joselu | Frontend Developer';
const siteUrl = 'https://joselu-portfolio.vercel.app';
const defaultDescription =
  'Portfolio de Joselu, desarrollador frontend especializado en React, Next.js y Astro. Proyectos, experiencia y habilidades en desarrollo web moderno.';
const metaDescription = description || defaultDescription;
const pageTitle = title === 'Joselu' ? siteName : `${title} | Joselu`;

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joselu',
  url: siteUrl,
  jobTitle: 'Frontend Developer',
  description: metaDescription,
  knowsAbout: ['React', 'Next.js', 'Astro', 'TypeScript', 'JavaScript'],
  sameAs: ['https://github.com/joselu', 'https://linkedin.com/in/joselu']
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/code.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={siteUrl} />

    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/og-image.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Joselu Frontend Developer - Avatar" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Joselu" />
    <meta name="twitter:creator" content="@Joselu" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.webp`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={structuredData} />

    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>
<style is:global>
  .wrapper {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }
  .smoke {
    color: rgba(var(--color-text-muted), 1);
  }

  .section-icon {
    width: 1em;
    color: rgba(var(--color), 1);
  }

  .building {
    color: rgb(var(--color), 1);
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
